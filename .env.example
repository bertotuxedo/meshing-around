# Optional Compose settings. Copy this file to .env, then edit as needed.
TZ=America/New_York
DASHBOARD_PORT=8420
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILES=3

# The Meshtastic connection and log level normally come from config.yaml.
# Uncomment these only when you intentionally want environment overrides.
# MESHTASTIC_HOST=192.168.1.95
# MESHTASTIC_PORT=4403
# LOG_LEVEL=INFO
